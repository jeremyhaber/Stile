{
  "manifest_version": 3,
  "name": "Stile",
  "version": "1.3.0",
  "description": "An Arc-style side panel: favourites, pinned tabs, today's tabs, auto-archive and profile switching.",
  "minimum_chrome_version": "116",
  "incognito": "spanning",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Stile",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Open Stile"
    },
    "capture-visible": {
      "description": "Screenshot: visible area"
    },
    "capture-full": {
      "description": "Screenshot: full page"
    },
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+3",
        "mac": "Alt+Shift+3"
      },
      "description": "Screenshot: select a region"
    }
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "alarms",
    "nativeMessaging",
    "search",
    "favicon",
    "identity",
    "identity.email",
    "tabGroups",
    "scripting",
    "userScripts",
    "contextMenus",
    "downloads",
    "downloads.open",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "boost-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
